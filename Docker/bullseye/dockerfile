ARG BASE_IMAGE=arm32v7/debian:bullseye
FROM ${BASE_IMAGE}

COPY --from=multiarch/qemu-user-static /usr/bin/qemu-arm-static /usr/bin/

# System setup with repository dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https \
        dirmngr \
        ca-certificates \
        software-properties-common \
        gnupg2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /machinekit/emca && \
    chmod 1777 /tmp && \
    # Add Machinekit repository key
    curl -fsSL https://deb.machinekit.io/apt.key | gpg --dearmor -o /etc/apt/trusted.gpg.d/machinekit.gpg && \
    echo "deb [arch=armhf] https://deb.machinekit.io/debian bullseye main" > /etc/apt/sources.list.d/machinekit.list

# Configure machinekit user
RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

USER machinekit
WORKDIR /machinekit/emca
