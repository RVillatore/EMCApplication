ARG BASE_IMAGE=arm32v7/debian:bullseye
FROM ${BASE_IMAGE}

# Copy QEMU binary
COPY --from=multiarch/qemu-user-static /usr/bin/qemu-arm-static /usr/bin/

# System setup with proper permissions
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /machinekit/emca && \
    chmod 777 /machinekit/emca

# User configuration with write permissions
RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

USER machinekit
WORKDIR /machinekit/emca
