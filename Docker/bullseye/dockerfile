# Global arguments
ARG DOCKER_PLATFORM=linux/arm/v7
ARG BASE_IMAGE=arm32v7/debian:bullseye

# Stage 0: QEMU setup
FROM --platform=${DOCKER_PLATFORM} multiarch/qemu-user-static AS qemu

# Stage 1: Base image with dependencies
FROM --platform=${DOCKER_PLATFORM} ${BASE_IMAGE} AS base

# Copy QEMU binary
COPY --from=qemu /usr/bin/qemu-arm-static /usr/bin/

# Install system dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https \
        dirmngr \
        ca-certificates \
        software-properties-common \
        gnupg2 \
        git \
        apt-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: User configuration
FROM base AS userconfig

RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

# Stage 3: Final image
FROM userconfig

# Configure repositories
RUN sudo curl -fsSL -o /etc/apt/trusted.gpg.d/machinekit.gpg \
    https://dl.cloudsmith.io/public/machinekit/machinekit/gpg.70528471A8369D24.key && \
    echo "deb [arch=armhf] https://dl.cloudsmith.io/public/machinekit/machinekit/deb/debian bullseye main" | \
    sudo tee /etc/apt/sources.list.d/machinekit.list

USER machinekit
WORKDIR /machinekit/emca

COPY --chown=machinekit:machinekit . .
