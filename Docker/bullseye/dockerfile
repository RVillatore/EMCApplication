# Stage 1: Base image with dependencies
ARG BASE_IMAGE=arm32v7/debian:bullseye
FROM ${BASE_IMAGE} as base

COPY --from=multiarch/qemu-user-static /usr/bin/qemu-arm-static /usr/bin/

# Install system dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https \
        dirmngr \
        ca-certificates \
        software-properties-common \
        gnupg2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: User configuration
FROM base as userconfig

RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

# Stage 3: Repository setup as machinekit user
FROM userconfig

# Switch to machinekit user for repository setup
USER machinekit
WORKDIR /machinekit/emca

# Add Cloudsmith repositories using sudo
RUN sudo curl -1sLf 'https://dl.cloudsmith.io/public/machinekit/machinekit/cfg/setup/bash.deb.sh' | sudo -E bash
RUN sudo curl -1sLf 'https://dl.cloudsmith.io/public/machinekit/machinekit-hal/cfg/setup/bash.deb.sh' | sudo -E bash

# Final application setup
COPY BuildPKG.sh /machinekit/emca/
