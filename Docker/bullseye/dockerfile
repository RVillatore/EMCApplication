FROM --platform=TARGETPLATFORM multiarch/qemu-user-static AS qemu

FROM ${TARGETPLATFORM}debian:bullseye
COPY --from=qemu /usr/bin/qemu-arm-static /usr/bin/

RUN apt update && \
    apt upgrade -y

RUN apt install -y build-essential fakeroot devscripts equivs sudo curl python lsb-release apt-cudf

RUN apt install -y gosu

RUN addgroup machinekit --gid 1000

RUN useradd -m -u 1000 -g 1000 -o -s /bin/bash machinekit

RUN echo "machinekit ALL = (ALL) NOPASSWD: ALL" >> /etc/sudoers

RUN apt install -y debian-keyring debian-archive-keyring apt-transport-https

USER machinekit
