# Stage 1: Base image with dependencies
ARG BASE_IMAGE=arm32v7/debian:bullseye
FROM ${BASE_IMAGE} as base

COPY --from=multiarch/qemu-user-static /usr/bin/qemu-arm-static /usr/bin/

# Install system dependencies including git
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https \
        dirmngr \
        ca-certificates \
        software-properties-common \
        gnupg2 \
        git \
        apt-utils && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Stage 2: User configuration
FROM base as userconfig

RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

# Stage 3: Repository setup
FROM userconfig

# Add Cloudsmith repositories with source entries
RUN sudo sh -c 'echo "deb [arch=armhf] https://dl.cloudsmith.io/public/machinekit/machinekit/deb/debian bullseye main" > /etc/apt/sources.list.d/machinekit.list' && \
    sudo sh -c 'echo "deb-src https://dl.cloudsmith.io/public/machinekit/machinekit/deb/debian bullseye main" >> /etc/apt/sources.list.d/machinekit.list' && \
    sudo sh -c 'echo "deb [arch=armhf] https://dl.cloudsmith.io/public/machinekit/machinekit-hal/deb/debian bullseye main" > /etc/apt/sources.list.d/machinekit-hal.list' && \
    sudo sh -c 'echo "deb-src https://dl.cloudsmith.io/public/machinekit/machinekit-hal/deb/debian bullseye main" >> /etc/apt/sources.list.d/machinekit-hal.list' && \
    sudo apt-key adv --keyserver keyserver.ubuntu.com --recv-key 43D640E7

# Final application setup with proper permissions
USER machinekit
WORKDIR /machinekit/emca

COPY --chown=machinekit:machinekit . /machinekit/emca/

RUN sudo chmod -R 755 /machinekit/emca && \
    sudo chown -R machinekit:machinekit /machinekit/emca
