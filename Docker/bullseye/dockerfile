ARG BASE_IMAGE=arm32v7/debian:bullseye
FROM ${BASE_IMAGE}

COPY --from=multiarch/qemu-user-static /usr/bin/qemu-arm-static /usr/bin/

# Base package installation
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        build-essential \
        fakeroot \
        devscripts \
        equivs \
        sudo \
        curl \
        python3 \
        lsb-release \
        apt-cudf \
        gosu \
        debian-keyring \
        debian-archive-keyring \
        apt-transport-https \
        dirmngr \
        ca-certificates \
        software-properties-common \
        gnupg2 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Repository setup with retries
RUN mkdir -p /machinekit/emca && \
    chmod 1777 /tmp && \
    { curl -fsSL https://deb.machinekit.io/apt.key | gpg --batch --dearmor -o /etc/apt/trusted.gpg.d/machinekit.gpg || \
      curl -fsSL https://deb.machinekit.io/apt.key | gpg --batch --dearmor -o /etc/apt/trusted.gpg.d/machinekit.gpg; } && \
    echo "deb [arch=armhf] https://dl.cloudsmith.io/public/machinekit/machinekit/debian/ubuntu bullseye main" > /etc/apt/sources.list.d/machinekit.list

# User configuration
RUN groupadd -g 1000 machinekit && \
    useradd -m -u 1000 -g 1000 -d /machinekit machinekit && \
    echo "machinekit ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    chown -R machinekit:machinekit /machinekit

USER machinekit
WORKDIR /machinekit/emca
